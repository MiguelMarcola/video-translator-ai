NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://video_translate:video_translate_local@localhost:5433/video_translate
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=video-translate-local
S3_ACCESS_KEY_ID=videotranslate
S3_SECRET_ACCESS_KEY=videotranslate_local_secret
S3_FORCE_PATH_STYLE=true

AUTH_MODE=development
ALLOW_DEV_IDENTITY=true

PYTHON_BIN=
MEDIA_WORKER_FORCE_IPV4=
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=5
MAX_VIDEO_DURATION_SECONDS=1800
RETENTION_DAYS=7
MAX_ACTIVE_VIDEOS_PER_USER=1
PRESIGN_TTL_SECONDS=900
STAGE_TIMEOUT_MS=1800000
MAX_CHAT_MESSAGES=40
CHAT_SIMILARITY_THRESHOLD=0.2
FONT_FILE=/System/Library/Fonts/Supplemental/Arial.ttf
FONT_FAMILY=Arial

OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=1536
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:3000
MEDIA_SIGNING_SECRET=
